  fhir:StructureDefinition.version [ fhir:value "0.3.0"] ;
  fhir:StructureDefinition.name [ fhir:value "KGPersona"] ;
  fhir:StructureDefinition.title [ fhir:value "Knowledge graph L2: Generic Persona"] ;
  fhir:StructureDefinition.status [ fhir:value "active"] ;
  fhir:StructureDefinition.date [ fhir:value "2026-11-19T20:24:57+00:00"^^xsd:dateTime] ;
  fhir:StructureDefinition.publisher [ fhir:value "WHO"] ;
  fhir:StructureDefinition.contact [
     fhir:index 0 ;
     fhir:ContactDetail.name [ fhir:value "WHO" ] ;
     fhir:ContactDetail.telecom [
       fhir:index 0 ;
       fhir:ContactPoint.system [ fhir:value "url" ] ;
       fhir:ContactPoint.value [ fhir:value "http://who.int" ]
     ]
  ] ;
  fhir:StructureDefinition.description [ fhir:value "DAK component 2. Grounded in GenericPersona.fsh -- title, id, description, otherNames, iscoCode bound to ISCO08ValueSet -- and in the 22 committed ActorDefinition instances that carry name, title, type and description. The two disagree about where ISCO lives, which the properties record rather than smooth over. `title` is the human-readable label a BPMN pool matches on; `name` is the CamelCase identifier a Canonical() reference matches on. They are different strings for the same persona and conflating them is precisely how the pool join breaks. GenericPersona.fsh declares `iscoCode 0..* code`, but the committed ActorDefinitions record ISCO in prose inside description, so iscoCode is usually empty and is not authoritative. Class IRI: http://smart.who.int/kg/persona."] ;
