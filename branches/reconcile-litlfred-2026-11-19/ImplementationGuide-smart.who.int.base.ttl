       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L2-DMN: DMN Decision Table" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The table realising a decision. Separate from dmn-decision because DMN permits other expression kinds -- a literal expression, an invocation -- and collapsing the two would make the graph unable to say which was used. hitPolicy is optional and recorded as null when absent, which it is in the BCG table. DMN's default is UNIQUE, but asserting it here would put words in the author's mouth. Class IRI: http://smart.who.int/kg/dmn-decision-table." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
