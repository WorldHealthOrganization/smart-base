         fhir:Reference.reference [ fhir:value "StructureDefinition/KGBpmnParticipant" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L2-BPMN: BPMN Participant" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A pool: a role that owns part of the collaboration. The lifecycle BPMN has 8 and declares no laneSet at all, so the pool is the only unit of role assignment present and its @name is the sole link to a persona. Class IRI: http://smart.who.int/kg/bpmn-participant." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
