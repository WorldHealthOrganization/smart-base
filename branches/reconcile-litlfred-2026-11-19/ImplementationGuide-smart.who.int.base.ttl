       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L2-BPMN: BPMN Event" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A start, end or intermediate event (WHO's DAK BPMN draw intermediate throw and catch events inside sub-processes). Same connectivity argument as gateway, plus one of its own: entry and exit points are what make 'is this task reachable' and 'does this path terminate' answerable at all. Class IRI: http://smart.who.int/kg/bpmn-event." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
