       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Health Interventions Source" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Source reference for Health Interventions - exactly one of the following must be provided:\n- url (url data type): URL to retrieve HealthInterventions definition from input/ or external source\n- canonical (canonical data type): Canonical URI pointing to the HealthInterventions definition\n- instance: Inline HealthInterventions instance data" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
