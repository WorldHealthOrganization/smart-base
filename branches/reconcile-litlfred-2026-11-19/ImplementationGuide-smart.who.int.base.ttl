       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Mapping to represent hierarchy within the Classification of Digital Health Interventions v1." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
