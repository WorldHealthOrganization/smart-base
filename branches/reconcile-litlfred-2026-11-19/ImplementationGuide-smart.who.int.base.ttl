         fhir:Reference.reference [ fhir:value "StructureDefinition/KGDmnRule" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L2-DMN: DMN Rule" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "One row. Its input and output cells are carried as properties, not nodes: 250 of them in the BCG table alone, none the target of a cross-model edge. What the rule needs a node for is its citation edge into L1. conditions and outputs are arrays of {clause, description, text}. DMN puts the formal expression in description and the human-readable gloss in text, and both are worth keeping -- the gloss is what a reviewer reads and the expression is what an implementer builds. Class IRI: http://smart.who.int/kg/dmn-rule." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
