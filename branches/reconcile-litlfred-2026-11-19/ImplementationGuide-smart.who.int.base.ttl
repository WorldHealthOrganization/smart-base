       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L3: Activity Definition" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A FHIR ActivityDefinition -- the concrete act a plan's action invokes. Reached from a PlanDefinition action's `definitionCanonical`, which is a real reference rather than a convention. 3 in the immunizations IG: two cpg-immunizationactivity, one cpg-communicationactivity. Class IRI: http://smart.who.int/kg/activity-definition." ] ;
