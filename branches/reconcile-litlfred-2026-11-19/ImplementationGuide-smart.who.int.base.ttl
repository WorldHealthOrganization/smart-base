       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/StructureDefinition/KGNonFunctionalRequirement> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/KGNonFunctionalRequirement" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L2: Non-Functional Requirement" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "DAK component 8, second half. `requirement 1..1 markdown`, an optional category and classification codings. Kept separate from the functional half because the fields genuinely differ -- a non-functional requirement has no actor and no benefit. resolutionStatus is `unresolved` on a component that something else names but no DAK declares -- an L3 artefact whose title carries the component id, for instance. The node exists so the gap is queryable and carries the referenced id and nothing else. Class IRI: http://smart.who.int/kg/non-functional-requirement." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
