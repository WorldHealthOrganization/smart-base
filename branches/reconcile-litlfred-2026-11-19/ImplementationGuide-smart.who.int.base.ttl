       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L1: outcome importance" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "All codes of KGOutcomeImportance." ] ;
