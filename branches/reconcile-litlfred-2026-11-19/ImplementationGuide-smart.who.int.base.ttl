       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L2-DMN: DMN Input Clause" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "An input column. Its expression text is where data element names are embedded, which is the only reason this is a node rather than a property of the table. Class IRI: http://smart.who.int/kg/dmn-input-clause." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
