         fhir:Reference.reference [ fhir:value "CodeSystem/KGL2Predicates" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L2: predicates" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The predicates of the L2 layer. An edge's `predicate` is one of these; which (source, target) pairs each licenses is the layer's edge table. Source: smart-base/L1/schemas/L2.ts (migrated from smart-kg ontology/L2/L2.json)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 177 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:logical" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/StructureDefinition/KGProgramIndicator> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/KGProgramIndicator" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L2: Program Indicator" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "DAK component 7. Named program-indicator and not `indicator` because L1 already declares an `indicator` -- one normatively defined in a publication. They are different things: this is the DAK's operational measure, and `derivedFrom` is how it points at the normative one. Collapsing them would silently merge a WHO definition with a country's implementation of it. numerator, denominator and disaggregation are all `1..1 markdown` -- prose, not a computable expression. Nothing here should be read as a calculable measure; the L3 FHIR Measure is where that would live. resolutionStatus is `unresolved` on a component that something else names but no DAK declares -- an L3 artefact whose title carries the component id, for instance. The node exists so the gap is queryable and carries the referenced id and nothing else. Class IRI: http://smart.who.int/kg/program-indicator." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 178 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ValueSet" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
