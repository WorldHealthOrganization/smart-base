       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Decision Support Logic Source" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Source reference for Decision Support Logic - exactly one of the following must be provided:\n- url (url data type): URL to retrieve DecisionSupportLogic definition from input/ or external source\n- canonical (canonical data type): Canonical URI pointing to the DecisionSupportLogic definition\n- instance: Inline DecisionSupportLogic instance data" ] ;
