       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L1: grc status" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Whether the Guideline Review Committee approved the publication. All WHO publications containing recommendations must be approved (handbook §1.10.1); a consolidated guideline whose recommendations were all previously approved and unchanged does not require review (§1.7.2). Absent means not recorded — not the same as not reviewed. Source: smart-kg ontology/l1/l1.json valueSets \"grc-status\"; WHO handbook for guideline development (2014), §1.7.2, §1.10.1." ] ;
