       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L2-DMN: DMN Decision" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A `dmn:decision` -- the question being answered, and the node that carries the link back to the BPMN task invoking it. A file may hold several; the BCG file holds one. Class IRI: http://smart.who.int/kg/dmn-decision." ] ;
