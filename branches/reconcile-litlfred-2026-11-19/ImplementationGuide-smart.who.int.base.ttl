       fhir:ImplementationGuide.definition.resource.description [ fhir:value "All codes of KGPublicationStatus." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
