       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Knowledge graph L1: Key question" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A question in PICO format, framed before the evidence search (handbook §7.1–7.4). P and C are verbatim text with codes through crossReferences; I is also joined to a catalogued intervention; O is the outcome node. Class IRI: http://smart.who.int/kg/key-question." ] ;
