  fhir:StructureDefinition.url [ fhir:value "http://smart.who.int/base/StructureDefinition/KGRequirementStatement"] ;
  fhir:StructureDefinition.version [ fhir:value "0.3.0"] ;
  fhir:StructureDefinition.name [ fhir:value "KGRequirementStatement"] ;
  fhir:StructureDefinition.title [ fhir:value "Knowledge graph L2: Requirement Statement"] ;
  fhir:StructureDefinition.status [ fhir:value "active"] ;
  fhir:StructureDefinition.date [ fhir:value "2026-11-23T18:43:32+00:00"^^xsd:dateTime] ;
  fhir:StructureDefinition.publisher [ fhir:value "WHO"] ;
  fhir:StructureDefinition.contact [
     fhir:index 0 ;
     fhir:ContactDetail.name [ fhir:value "WHO" ] ;
