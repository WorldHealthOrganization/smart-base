  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "KGRequirementStatement" ] ;
       fhir:ElementDefinition.path [ fhir:value "KGRequirementStatement" ] ;
       fhir:ElementDefinition.short [ fhir:value "Knowledge graph L2: Requirement Statement" ] ;
       fhir:ElementDefinition.definition [ fhir:value "One numbered, labelled statement inside a requirement, with a conformance verb. A node rather than a property because conformance is queried across a whole DAK -- 'every SHALL in this kit, and what fulfils it' is the question requirements exist to answer. It also carries its own success criteria, so 'what would show this SHALL is met' is answerable per statement rather than per requirement. conformance is the FHIR ConformanceExpectation verb: SHALL, SHOULD, MAY or SHOULD-NOT. Across the 41 committed instances it is 155 SHALL and 15 SHOULD. successCriteria is a LIST of objects, each {key, criterion, verification}: `key` is unique within the statement (e.g. SC-1), `criterion` is a checkable sentence, and `verification` is one of test | inspection | review | analysis -- the same field name and enum as folio-assistant's requirement.ts `successCriteria`, so the two map 1:1. smart-base types it, so the shape is enforced by the schema; a statement with no successCriteria is still valid (the 170 statements committed in smart-base carry none). Class IRI: http://smart.who.int/kg/requirement-statement." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "KGRequirementStatement.key" ] ;
       fhir:ElementDefinition.path [ fhir:value "KGRequirementStatement.key" ] ;
       fhir:ElementDefinition.short [ fhir:value "Key" ] ;
       fhir:ElementDefinition.definition [ fhir:value "The statement's key, unique within its requirement." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
